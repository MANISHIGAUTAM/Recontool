# ─────────────────────────────────────────────────────────────────────────
# Recontool configuration. Copy to `.env` and fill in. ALL keys are optional —
# the platform runs passive recon out-of-the-box using free, keyless sources.
# Adding keys unlocks more sources and higher rate limits.
# ─────────────────────────────────────────────────────────────────────────

# ── Run mode (the top-level safety switch) ───────────────────────────────────
# demo : full pipeline against the built-in MOCK env; NO real egress. Zero keys.
# test : recorded fixtures / mock; real egress BLOCKED (CI/E2E).
# live : real authorized targets; egress permitted (scope + auth gated).
RECON_MODE=live

# ── Storage ────────────────────────────────────────────────────────────────
# SQLite (default, zero-setup) or PostgreSQL.
RECON_DB_URL=sqlite:///recontool.db
# RECON_DB_URL=postgresql+psycopg://recon:recon@postgres:5432/recontool

# Where JS files, response bodies, screenshots, raw tool output are stored.
RECON_ARTIFACT_DIR=./artifacts

# Optional Redis for distributed rate-limit buckets (falls back to in-process).
# RECON_REDIS_URL=redis://redis:6379/0

# ── Logging / observability ──────────────────────────────────────────────────
RECON_LOG_FORMAT=json          # json | text
RECON_LOG_LEVEL=INFO

# ── Network / OPSEC (authorized-only, no evasion) ────────────────────────────
# Default rate profile: passive_only | stealth | normal | aggressive
RECON_PROFILE=normal
# Global concurrency cap across the whole pipeline.
RECON_MAX_CONCURRENCY=20

# ── Provider API keys (ALL optional — passive recon runs with none) ──────────
# Each maps to a provider block in config/providers.yaml (auth_env field).
# The config layer FAILS FAST if a provider is enabled but its key is missing.
#
# dns_cert / passive_index
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
CERTSPOTTER_API_KEY=
SECURITYTRAILS_API_KEY=
VIRUSTOTAL_API_KEY=
CHAOS_API_KEY=
# search engines / metasearch
URLSCAN_API_KEY=
BRAVE_SEARCH_API_KEY=
# code search
GITHUB_TOKEN=
GITLAB_TOKEN=
# threat intel
GREYNOISE_API_KEY=
NVD_API_KEY=
VULNERS_API_KEY=
# cloud / storage
GRAYHATWARFARE_API_KEY=
# identity / social (PII-gated — enable deliberately)
HUNTER_API_KEY=
HIBP_API_KEY=
# physical / geo / wireless
WIGLE_API_KEY=

# ── AI supervisor ────────────────────────────────────────────────────────────
# If unset, the supervisor uses fast deterministic heuristics (no tokens spent).
# OpenAI-compatible: works with OpenAI, or a LOCAL server (Ollama/vLLM/LM Studio).
# RECON_AI_BASE_URL=https://api.openai.com/v1
# RECON_AI_BASE_URL=http://localhost:11434/v1     # local Ollama
RECON_AI_API_KEY=
RECON_AI_MODEL_LIGHT=gpt-4o-mini
RECON_AI_MODEL_HEAVY=gpt-4o
RECON_AI_MAX_CALLS=40
