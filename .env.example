# ─────────────────────────────────────────────────────────────────────────
# Recontool configuration. Copy to `.env` and fill in. ALL keys are optional —
# the platform runs passive recon out-of-the-box using free, keyless sources.
# Adding keys unlocks more sources and higher rate limits.
# ─────────────────────────────────────────────────────────────────────────

# ── Storage ────────────────────────────────────────────────────────────────
# SQLite (default, zero-setup) or PostgreSQL.
RECON_DB_URL=sqlite:///recontool.db
# RECON_DB_URL=postgresql+psycopg://recon:recon@localhost:5432/recontool

# Where JS files, response bodies, screenshots, raw tool output are stored.
RECON_ARTIFACT_DIR=./artifacts

# Optional Redis for distributed rate-limit buckets (falls back to in-process).
# RECON_REDIS_URL=redis://localhost:6379/0

# ── Network / OPSEC ──────────────────────────────────────────────────────────
# Comma-separated proxy URLs for IP rotation. Empty = direct egress.
# Format: http://user:pass@host:port  or  socks5://host:port
RECON_PROXIES=
# Rotation strategy: round_robin | random | sticky
RECON_PROXY_STRATEGY=round_robin
# Default rate profile: passive_only | stealth | normal | aggressive
RECON_PROFILE=normal
# Global concurrency cap across the whole pipeline.
RECON_MAX_CONCURRENCY=20

# ── AI supervisor ────────────────────────────────────────────────────────────
# If unset, the supervisor uses fast deterministic heuristics (no tokens spent).
# OpenAI-compatible: works with OpenAI, or a LOCAL server (Ollama/vLLM/LM Studio).
# RECON_AI_BASE_URL=https://api.openai.com/v1
# RECON_AI_BASE_URL=http://localhost:11434/v1     # local Ollama
RECON_AI_API_KEY=
# Tiered models: light = cheap/fast triage, heavy = deep reasoning.
RECON_AI_MODEL_LIGHT=gpt-4o-mini
RECON_AI_MODEL_HEAVY=gpt-4o
# Hard cap on AI calls per scan (token-budget guard). 0 = unlimited.
RECON_AI_MAX_CALLS=40

# ── API / UI server (recontool serve) ────────────────────────────────────────
# Bearer token REQUIRED to expose any data/control route (default-deny -> 503).
#   generate one:  openssl rand -hex 16
RECON_API_TOKEN=
RECON_API_HOST=127.0.0.1
RECON_API_PORT=8088

# ── Provider API keys (all optional) ─────────────────────────────────────────
# Internet-wide search
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
NETLAS_API_KEY=
GREYNOISE_API_KEY=
LEAKIX_API_KEY=
FULLHUNT_API_KEY=
URLSCAN_API_KEY=
CRIMINALIP_API_KEY=
BINARYEDGE_API_KEY=
ZOOMEYE_API_KEY=
# Passive DNS / subdomains
SECURITYTRAILS_API_KEY=
VIRUSTOTAL_API_KEY=
CHAOS_API_KEY=
CERTSPOTTER_API_KEY=
# Network intel
IPINFO_TOKEN=
# IP reputation / abuse score (Cat 12 — abuseipdb adapter; skips cleanly if unset)
ABUSEIPDB_API_KEY=
# abuse.ch threat intel — threatfox (IOC lookup) + urlhaus (malware URLs by host);
# one free Auth-Key covers both. Cat 12; skips cleanly if unset.
ABUSECH_AUTH_KEY=
# Source code
GITHUB_TOKEN=
GITLAB_TOKEN=
# Cloud buckets
GRAYHATWARFARE_API_KEY=
# Org-forest pivots (sibling-site discovery via shared fingerprints)
PUBLICWWW_API_KEY=
# Identity / breach-exposure (Cat 7 — PII, legally gated; enable deliberately)
HUNTER_API_KEY=
HIBP_API_KEY=
# breachdirectory adapter (RapidAPI key); emits REDACTED findings only
BREACHDIRECTORY_API_KEY=
# Vuln intel / CVE enrichment
NVD_API_KEY=
VULNERS_API_KEY=
